{
  "title": "VisualTDD reference test map",
  "output": "docs/reference-test-map.html",
  "testRoots": ["test/engine.test.mjs", "test/cli.test.mjs", "test/page.test.mjs", "test/scenarios.test.mjs"],
  "languages": ["js"],
  "specs": {
    "source": "markdown",
    "files": ["docs/spec.md"],
    "idPattern": "(?<prefix>N?FR)-(?<num>\\d+)",
    "groups": { "FR": "Functional requirements", "NFR": "Non-functional requirements" }
  },
  "tiers": [
    { "k": "engine", "name": "Engine", "what": "Config, scanning, specs and the model" },
    { "k": "cli", "name": "CLI", "what": "The command run as a process: flags, exit codes, files" },
    { "k": "page", "name": "Page", "what": "The generated HTML dashboard" }
  ],
  "tierFromPath": [
    { "pattern": "(^|/)engine\\.test\\.mjs$", "tier": "engine" },
    { "pattern": "(^|/)cli\\.test\\.mjs$", "tier": "cli" },
    { "pattern": "(^|/)page\\.test\\.mjs$", "tier": "page" },
    { "pattern": "(^|/)scenarios\\.test\\.mjs$", "tier": "page" }
  ]
}
