{
  "name": "visualtdd",
  "version": "0.1.0",
  "description": "Tag tests with the spec, category and tier they cover; build a dashboard of test counts per spec.",
  "type": "module",
  "bin": { "visualtdd": "visualtdd.mjs" },
  "engines": { "node": ">=22" },
  "files": ["visualtdd.mjs", "template.html"],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "map": "node visualtdd.mjs",
    "map:check": "node visualtdd.mjs --check"
  },
  "license": "UNLICENSED",
  "private": true
}
